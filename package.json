{
  "name": "Kancolle-browser",
  "productName": "艦娘は今日もお仕事です（仮）",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Kancolle Dedicated Browser",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n \"vite,electron\" -c \"yellow,blue\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "typecheck:renderer": "tsc --project tsconfig.renderer.json",
    "typecheck:electron": "tsc --project tsconfig.electron.json",
    "test:kancolle": "node --test tests/kancolle-data.test.cjs",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "build:electron": "npm run typecheck:electron && node scripts/build-electron.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^8.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "afterPack": "./scripts/after-pack.cjs",
    "artifactBuildCompleted": "./scripts/after-artifact-build.cjs",
    "appId": "jp.ytokuda.kancollebrowser",
    "productName": "艦娘は今日もお仕事です（仮）",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "DISTRIBUTION-NOTES.txt",
          "electron-LICENSE.txt",
          "LICENSES.chromium.html",
          "react-LICENSE.txt",
          "react-dom-LICENSE.txt",
          "scheduler-LICENSE.txt",
          "npm/js-tokens-LICENSE.txt",
          "npm/loose-envify-LICENSE.txt",
          "electron-components/Mantle-LICENSE.md",
          "electron-components/ReactiveObjC-LICENSE.md",
          "electron-components/Squirrel-LICENSE.txt",
          "electron-components/LGPL-2.1.txt",
          "electron-components/FFmpeg-CREDITS.txt",
          "ELECTRON-SOURCES.txt",
          "electron-components/nbytes-LICENSE.txt",
          "windows/NSIS-COPYING.txt",
          "windows/StdUtils-ReadMe.txt",
          "windows/StdUtils-README.html",
          "windows/StdUtils-rhash-COPYING.txt",
          "windows/StdUtils-blake2-COPYING.txt",
          "windows/nsis7z-README.txt",
          "windows/nsis7z-LZMA-SDK-LICENSE.txt",
          "windows/elevate-upstream-LICENSE.md",
          "windows/electron-builder-LICENSE.txt",
          "windows/SOURCES.txt"
        ]
      }
    ],
    "mac": {
      "executableName": "KancolleBrowser",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "publish": {
      "provider": "github",
      "owner": "ytokuda-devlop",
      "repo": "kancolle-browser",
      "releaseType": "draft"
    },
    "portable": {
      "artifactName": "kancolle-browser_${version}_win.exe",
      "requestExecutionLevel": "user"
    }
  }
}
