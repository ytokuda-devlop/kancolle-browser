{
  "name": "Kancolle-browser",
  "productName": "艦娘は今日もお仕事です（仮）",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Kancolle Dedicated Browser",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"vite,electron\" -c \"yellow,blue\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^8.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "8.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "afterPack": "./scripts/after-pack.cjs",
    "appId": "jp.ytokuda.kancollebrowser",
    "productName": "艦娘は今日もお仕事です（仮）",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "executableName": "KancolleBrowser",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ytokuda-devlop",
      "repo": "kancolle-browser",
      "releaseType": "draft"
    }
  }
}
